{
  "name": "kakeklar",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Kakeklar: Norwegian kids' birthday party purchase planner – two sliders, instant shopping quantities.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch --env-file=.env server/index.js",
    "build": "vite build",
    "build:production": "node scripts/validate-build-env.mjs && node scripts/build-content.mjs && vite build && node scripts/prerender.mjs",
    "verify:production-build": "node scripts/verify-production-build.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "insights": "pwsh -NoProfile -File scripts/insights.ps1",
    "start": "node server/index.js",
    "start:local": "node --env-file=.env server/index.js",
    "preview": "vite preview",
    "test:api": "node --test api/test/handlers.test.cjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "content": "node scripts/build-content.mjs",
    "predev": "node scripts/build-content.mjs",
    "prebuild": "node scripts/build-content.mjs",
    "postbuild": "node scripts/prerender.mjs"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@microsoft/applicationinsights-web": "^3.3.4",
    "@playwright/test": "^1.49.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "marked": "^15.0.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
